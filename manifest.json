{
  "manifest_version": 3,
  "name": "Memoria",
  "version": "1.2.0",
  "description": "Memoria - Personal virtual assistant featuring AI Chat, Notes, Clipboard, Timer, Translation, OCR, and Weather.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "offscreen",
    "sidePanel",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/modules/clipboard.js",
        "content/modules/reminder.js",
        "content/modules/translate.js",
        "content/modules/allowCopy.js",
        "content/modules/ocr-translate.js"
      ]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open Memoria Side Panel"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Open Memoria Panel"
    },
    "open_chat_tab": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Open AI Chat"
    },
    "open_translate_tab": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "Open Translation"
    },
    "open_notes_tab": {
      "description": "Open Notes"
    },
    "trigger_ocr": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Trigger OCR and Translation"
    },
    "open_timer_tab": {
      "description": "Open Timer"
    },
    "open_weather_tab": {
      "description": "Open Weather"
    },
    "open_settings_tab": {
      "description": "Open Settings"
    }
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "options_page": "ui/settings.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "lib/tesseract/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
