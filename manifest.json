{
  "manifest_version": 3,
  "name": "Memoria",
  "version": "1.0",
  "description": "Memoria - Trợ lý ảo toàn diện với AI, Quản lý Lịch trình, Ghi chú và Clipboard thông minh",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "offscreen",
    "sidePanel",
    "scripting",
    "notifications",
    "idle",
    "identity"
  ],
  "oauth2": {
    "client_id": "149376920922-0po7h9o6j9t8v7fgkusmlqr16mvne9s0.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar",
      "https://www.googleapis.com/auth/tasks",
      "openid",
      "email",
      "profile"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/modules/clipboard.js",
        "content/modules/reminder.js",
        "content/modules/translate.js",
        "content/modules/allowCopy.js",
        "content/modules/ocr-translate.js"
      ]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Mở Side Panel Memoria"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Mở bảng điều khiển Memoria"
    },
    "open_translate_tab": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "Mở Memoria và nhảy tới Tab Dịch thuật"
    }
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "options_page": "ui/settings.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "lib/tesseract/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
